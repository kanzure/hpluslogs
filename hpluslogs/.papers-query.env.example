# Copy to .papers-query.env and set your worker/model. No credentials here.
# Existing environment variables override these defaults.
: "${PAPERS_HOST:=conversion-server.example}"
: "${PAPERS_USER:=your-user}"
: "${PAPERS_PATH:=/home/your-user/hpluslogs-papers-conversion}"
: "${PAPERS_LLM_MODEL:=your-local-served-model-name}"
: "${PAPERS_PUBLISH_USER:=bryan}"
: "${PAPERS_PUBLISH_HOST:=gnusha.org}"
: "${PAPERS_PUBLISH_PATH:=~/public_html/irc/chatgpt/papers2/}"
: "${PAPERS_PUBLIC_URL:=https://diyhpl.us/~bryan/irc/chatgpt/papers2}"
