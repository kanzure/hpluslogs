#!/usr/bin/env bash
# Query the remote paper index, summarize, and publish through this machine.
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]]; then
    cat <<'HELP'
Usage: hpluslogs/papers-query 'Your question about the papers'

Queries Chroma and the worker's LLM, renders Markdown/HTML locally, uploads
both to the publishing server, and prints their public URLs.
No virtualenv activation needed. Settings: hpluslogs/.papers-query.env
(or PAPERS_QUERY_CONFIG). See .papers-query.env.example for first-time setup.

Optional environment overrides:
  PAPERS_TOP_K=100           Number of retrieved passages (1-100)
  PAPERS_OUTPUT_NAME=name    Filename without extension (default: timestamp)
  PAPERS_LLM_MODEL=model    Worker model name
  PAPERS_PROMPT_FRAGMENT='Compare methods and suggest experiments'
  PAPERS_BRIEF=1             Concise answer instead of the default technical report
  PAPERS_MAX_ANSWER_TOKENS=8192  Override report output token limit
HELP
    exit 0
fi
if [[ $# -ne 1 || -z "$1" ]]; then
    printf "Usage: %s 'Your question about the papers'\n" "$0" >&2
    exit 2
fi

config="${PAPERS_QUERY_CONFIG:-$project_dir/.papers-query.env}"
if [[ -f "$config" ]]; then
    # User-owned shell settings; the example preserves environment overrides.
    source "$config"
fi
for setting in PAPERS_HOST PAPERS_USER PAPERS_PATH PAPERS_LLM_MODEL PAPERS_PUBLIC_URL; do
    if [[ -z "${!setting:-}" ]]; then
        printf 'Missing %s. Configure %s using %s/.papers-query.env.example\n' \
            "$setting" "$config" "$project_dir" >&2
        exit 2
    fi
done
python="${PAPERS_PYTHON:-$project_dir/venv/bin/python}"
if [[ ! -x "$python" ]]; then
    printf 'Python environment missing: %s (or set PAPERS_PYTHON).\n' "$python" >&2
    exit 2
fi
name="${PAPERS_OUTPUT_NAME:-papers_$(date -u +%Y%m%dT%H%M%S_%N)}"
analysis_options=(--prompt-fragment "${PAPERS_PROMPT_FRAGMENT:-}")
if [[ "${PAPERS_BRIEF:-0}" == 1 ]]; then
    analysis_options+=(--brief)
fi
if [[ -n "${PAPERS_MAX_ANSWER_TOKENS:-}" ]]; then
    analysis_options+=(--max-answer-tokens "$PAPERS_MAX_ANSWER_TOKENS")
fi
cd "$project_dir/.."
"$python" -m hpluslogs.cli --data-dir "${PAPERS_DATA_DIR:-$project_dir/data}" papers-remote-query \
    --host "$PAPERS_HOST" --user "$PAPERS_USER" --path "$PAPERS_PATH" \
    --model "$PAPERS_LLM_MODEL" --llm-url "${PAPERS_LLM_URL:-http://127.0.0.1:8080/v1}" \
    --chroma-port "${PAPERS_CHROMA_PORT:-18081}" --top-k "${PAPERS_TOP_K:-100}" \
    --output-name "$name" --upload \
    "${analysis_options[@]}" \
    --remote-user "${PAPERS_PUBLISH_USER:-bryan}" --remote-host "${PAPERS_PUBLISH_HOST:-gnusha.org}" \
    --remote-path "${PAPERS_PUBLISH_PATH:-~/public_html/irc/chatgpt/papers2/}" \
    -- "$1"
printf '\nHTML: %s/%s.html\nMarkdown: %s/%s.md\n' \
    "${PAPERS_PUBLIC_URL%/}" "$name" "${PAPERS_PUBLIC_URL%/}" "$name"
